{
  "name": "tg-currency-bot",
  "version": "1.0.0",
  "description": "Telegram-бот: находит код валюты в тексте и отвечает её курсом к USD",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --watch src/server.js",
    "start": "node --env-file-if-exists=.env --env-file-if-exists=.env.local src/server.js",
    "bot:dev": "node --env-file-if-exists=.env --env-file-if-exists=.env.local src/poller.js",
    "test": "node --test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "fastify": "^5.12.3"
  }
}
